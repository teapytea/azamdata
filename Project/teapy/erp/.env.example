# Supabase > Connect > Transaction pooler (port 6543).
# Kosongkan saat development lokal: aplikasi memakai Postgres tersemat di folder .data.
DATABASE_URL=

# Rahasia acak minimal 32 karakter untuk menandatangani sesi login.
AUTH_SECRET=

# Kode rahasia untuk /setup (membuat akun owner) dan /recover (reset password owner).
SETUP_TOKEN=
